// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Search Error Message > Renders a message with a search query 1`] = `"<div class="error-msg__container"><span class="error__msg" data-testid="error__msg"><span class="error__msg--apology">Sorry, we’re unable to display results<span class="error__msg--query"> for <strong>Search Query</strong></span> right now. </span><span class="error-msg__common">Please try a different query, try again later, or <a href="Survey URL" target="_blank" rel="noopener noreferrer">let us know</a>.</span></span></div>"`;

exports[`Search Error Message > Renders a message without a search query 1`] = `"<div class="error-msg__container"><span class="error__msg" data-testid="error__msg"><span class="error__msg--apology">Sorry, we’re unable to display results<!--v-if--> right now. </span><span class="error-msg__common">Please try a different query, try again later, or <a href="Survey URL" target="_blank" rel="noopener noreferrer">let us know</a>.</span></span></div>"`;

exports[`Search Error Message > Renders a message without an apology 1`] = `"<div class="error-msg__container"><span class="error__msg" data-testid="error__msg"><!--v-if--><span class="error-msg__common">Please try a different query, try again later, or <a href="Survey URL" target="_blank" rel="noopener noreferrer">let us know</a>.</span></span></div>"`;
